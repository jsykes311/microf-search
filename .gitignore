# ── Ignore everything by default ────────────────────────────────────────────
*

# ── Then explicitly allow the app files ─────────────────────────────────────
!.gitignore
!.github/
!.github/**
!main.py
!requirements.txt
!static/
!static/**

# ── Never allow secrets or caches, even inside static/ ──────────────────────
.env
__pycache__/
*.pyc
*.pyo
.DS_Store

!marketing.py
!marketing-ui/
!marketing-ui/**
!tests/
!tests/**
marketing-ui/node_modules/
.env
__pycache__/
*.pyc
*.pyo
.DS_Store
